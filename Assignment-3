// Task 1.1
func parseReading(_ raw: String) -> Reading? {
    guard let (sensor, valueStr) = splitOnce(raw, by: ":"),
          !sensor.isEmpty,
          let value = Int(valueStr),
          value >= 0 || sensor == "TEMP" else {
        return nil
    }
    return (sensor: sensor, value: value)
}
