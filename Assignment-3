// Task 3.1
func heatUp(_ temp: Int) -> Int { return temp + 5 }
func coolDown(_ temp: Int) -> Int { return temp - 3 }
func hold(_ temp: Int) -> Int { return temp }
func chooseProtocol(for temp: Int) -> (Int) -> Int {
    if temp < 18 { return heatUp }
    if temp > 24 { return coolDown }
    return hold
}
