// Task 2.1
func select(_ readings: [Reading], where isIncluded: (Reading) -> Bool) -> [Reading] {
    var result: [Reading] = []
    for r in readings {
        if isIncluded(r) {
            result.append(r)
        }
    }
    return result
}
func values(of readings: [Reading]) -> [Int] {
    var result: [Int] = []
    for r in readings {
        result.append(r.value)
    }
    return result
}
